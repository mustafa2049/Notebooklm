    "@capacitor/share": "^7.0.4",
    "@mediapipe/tasks-vision": "^1.1.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.31",
