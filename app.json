{
  "expo": {
    "name": "Hızlı Okuma",
    "slug": "hizli-okuma",
    "scheme": "hizliokuma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hizliokuma.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "lang": "tr",
      "themeColor": "#0B0D10",
      "description": "Metinlerini RSVP, parça parça, Bionic ve yürüyen vurgu ile hızlı oku."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0D10"
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitap sayfalarının fotoğraflarını metne çevirmek için galerine erişir.",
          "cameraPermission": "Kitap sayfalarını çekip metne çevirmek için kamerayı kullanır.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
