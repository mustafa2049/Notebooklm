{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Goz Egzersiz",
  "mainBinaryName": "goz-egzersiz",
  "version": "0.1.0",
  "identifier": "com.gozegzersiz.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Göz Egzersiz",
        "width": 1100,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Medical",
    "shortDescription": "Göz tembelliği tedavisine destek",
    "longDescription": "Kapama zamanlayıcısı, tek göz egzersizleri, kırmızı-mavi gözlükle dikoptik oyunlar, görme ve 3D görme testleri, Gabor eğitimi ve doktor raporu.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
